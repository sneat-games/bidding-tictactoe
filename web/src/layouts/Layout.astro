---
import "../styles/global.css";
// The CrazyGames SDK v3 script is deliberately NOT in this head. A static
// third-party tag there is render-blocking, and off CrazyGames it buys
// nothing: the SDK initialises to `environment: "disabled"` and does no work,
// while costing 7-10s before the menu appears on
// bidding-tictactoe.sneat.games.
//
// `src/crazygames/sdk.ts` injects the script on demand instead, and only on a
// CrazyGames surface — still awaiting `init()` before any other SDK call, as
// https://docs.crazygames.com/sdk/intro/ requires.
//
// `preconnect` is a hint, not a fetch: it warms the TLS handshake for the
// surfaces that will ask for the SDK, and costs nothing on those that won't.
const { title = "Bidding Tic-Tac-Toe" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://sdk.crazygames.com" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
