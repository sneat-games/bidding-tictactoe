{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["src/engine/*"],
      "@bot/*": ["src/bot/*"],
      "@crazygames/*": ["src/crazygames/*"]
    },
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*", "e2e/**/*", "*.config.*"],
  "exclude": ["dist", "node_modules"]
}