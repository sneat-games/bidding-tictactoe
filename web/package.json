{
  "name": "bidding-tictactoe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-only Astro + TypeScript web build of Bidding Tic-Tac-Toe for CrazyGames and sneat.games/bidding-tictactoe/.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && sneat-relativize-dist",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . --ext .ts,.astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen-icons": "node scripts/gen-icons.mjs",
    "relay": "node ./node_modules/@sneat/game-kit/dist/test-relay.mjs"
  },
  "dependencies": {
    "@sneat/game-kit": "github:sneat-games/game-kit#v0.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.10.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
