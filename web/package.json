{
  "name": "bidding-tictactoe-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-only Astro + TypeScript web build of Bidding Tic-Tac-Toe for CrazyGames.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit && tsc --noEmit --project signaling-worker/tsconfig.json && tsc --noEmit --project host-worker/tsconfig.json",
    "lint": "eslint . --ext .ts,.astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev --config signaling-worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config signaling-worker/wrangler.jsonc",
    "host:dev": "wrangler dev --config host-worker/wrangler.jsonc",
    "host:deploy": "wrangler deploy --config host-worker/wrangler.jsonc"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^4.20250807.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "astro": "^5.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-astro": "^1.3.0",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.120.1"
  },
  "engines": {
    "node": ">=22"
  }
}
